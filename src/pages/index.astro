---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

// Fetch works for bottom right showcase
const allWorks = (await getCollection("works")).sort(
    (a, b) => a.data.order - b.data.order,
);
const showcaseWorks = allWorks.slice(0, 3);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${SITE_TITLE} | Fullstack Software Engineer`} description={SITE_DESCRIPTION} />
    </head>
    <body class="poster-body">
        <Header />

        <div class="poster-container">
            <!-- ==============================================================
                 1. TOP SECTION: HERO BANNER (MAHITO STYLE)
                 ============================================================== -->
            <section id="hero" class="hero-poster-section">
                <div class="hero-bg-fx"></div>
                <div class="hero-particles"></div>

                <div class="hero-inner">
                    <!-- Left: Hero Typography & Info -->
                    <div class="hero-text-col">
                        <div class="hero-main-title-wrap">
                            <h1 class="hero-big-title">PROGRAMER MALAS</h1>
                            <div class="hero-category-subtitle">Fullstack Software Engineer</div>
                        </div>

                        <p class="hero-lead-text">
                            Is a Senior Lead Software Engineer with over 11 years of experience architecting distributed high-availability systems, mission-critical web platforms, and mentoring engineering teams.
                        </p>

                        <div class="hero-btn-wrap">
                            <div class="btn-read-more-line">
                                <a href="/works" class="btn-read-more">My Works</a>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Hero Visual Artwork -->
                    <div class="hero-art-col">
                        <div class="art-aura-glow"></div>
                        <div class="hero-art-frame">
                            <img
                                src="/avatar/standprogramer.webp"
                                alt="Aliem - Fullstack Software Engineer"
                                class="hero-character-img"
                            />
                        </div>
                    </div>
                </div>
            </section>

            <!-- ==============================================================
                 2. MIDDLE SECTION: BIOGRAPHICAL INFORMATION & SPECS DOSSIER
                 ============================================================== -->
            <section id="about" class="dossier-poster-section">
                <div class="dossier-bg-particles" aria-hidden="true">
                    <span class="particle p-1"></span>
                    <span class="particle p-2"></span>
                    <span class="particle p-3"></span>
                    <span class="particle p-4"></span>
                    <span class="particle p-5"></span>
                    <span class="particle p-6"></span>
                </div>

                <div class="dossier-inner">
                    <!-- Left: Character Standee with Stamp Badge -->
                    <div class="dossier-standee-col">

                        <!-- Standee Character Card Frame -->
                        <div class="standee-wrapper">
                            <img
                                src="/avatar/programer_malas.webp"
                                alt="Aliem Character Standee"
                                class="standee-img"
                            />
                        </div>
                    </div>

                    <!-- Center: 3 Specification Blocks matching layout.jpg -->
                    <div class="dossier-data-col">
                        <!-- Block 1: BIOGRAPHICAL INFORMATION -->
                        <div id="bio" class="dossier-spec-group">
                            <div class="spec-group-header">
                                <h3 class="spec-header-title">BIOGRAPHICAL INFORMATION</h3>
                            </div>
                            <div class="spec-items">
                                <div class="spec-row">
                                    <span class="spec-bullet">&gt;</span>
                                    <span class="spec-label">NAMA :</span>
                                    <span class="spec-text">Aliem Arif Perkasa</span>
                                </div>
                                <div class="spec-row">
                                    <span class="spec-bullet">&gt;</span>
                                    <span class="spec-label">ALIAS :</span>
                                    <span class="spec-text">Programer Malas</span>
                                </div>
                            </div>
                        </div>

                        <!-- Block 2: PERSONAL DESCRIPTION -->
                        <div id="skills" class="dossier-spec-group">
                            <div class="spec-group-header">
                                <h3 class="spec-header-title">PERSONAL DESCRIPTION</h3>
                            </div>
                            <div class="spec-items">
                                <div class="spec-row">
                                    <span class="spec-bullet">&gt;</span>
                                    <span class="spec-label">SPECIALIZATION :</span>
                                    <span class="spec-text">Fullstack Developer</span>
                                </div>
                                <div class="spec-row">
                                    <span class="spec-bullet">&gt;</span>
                                    <span class="spec-label">CORE STACK :</span>
                                    <span class="spec-text">TypeScript, Javascript, PHP, Python, GO</span>
                                </div>
                                <div class="spec-row">
                                    <span class="spec-bullet">&gt;</span>
                                    <span class="spec-label">FRAMEWORKS :</span>
                                    <span class="spec-text">Laravel, Vue.js, React, Langchain, Langgraph, FastAPI, Django, Flask</span>
                                </div>
                                <div class="spec-row">
                                    <span class="spec-bullet">&gt;</span>
                                    <span class="spec-label">EXPERIENCE :</span>
                                    <span class="spec-text">11+ Years of Production Shipping</span>
                                </div>
                            </div>
                        </div>

                        <!-- Block 3: PROFESSIONAL STATUS -->
                        <div id="status" class="dossier-spec-group">
                            <div class="spec-group-header">
                                <h3 class="spec-header-title">PROFESSIONAL STATUS</h3>
                            </div>
                            <div class="spec-items">
                                <div class="spec-row">
                                    <span class="spec-bullet">&gt;</span>
                                    <span class="spec-label">STATUS :</span>
                                    <span class="spec-text highlight-cyan">Assistant Manager @ Ejen2u International Sdn Bhd</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <Footer />
    </body>
</html>

<style>
    /* ── Poster Canvas Layout ─────────────────────────────────────────── */
    .poster-body {
        background-color: var(--bg-canvas);
        color: var(--text-light);
        margin: 0;
        padding: 0;
    }

    .poster-container {
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
    }

    /* ===================================================================
       1. TOP HERO SECTION
       =================================================================== */
    .hero-poster-section {
        position: relative;
        background: linear-gradient(180deg, #0c172a 0%, #0d1a2d 60%, #0e1b2f 100%);
        padding: 4rem 3rem 4rem;
        overflow: hidden;
        border-bottom: 1px solid rgba(56, 189, 248, 0.25);
    }

    .hero-bg-fx {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        background: 
            radial-gradient(circle at 75% 30%, rgba(56, 189, 248, 0.22) 0%, rgba(14, 165, 233, 0.08) 45%, transparent 70%),
            radial-gradient(circle at 20% 80%, rgba(59, 130, 246, 0.12) 0%, transparent 50%);
        pointer-events: none;
    }

    .hero-inner {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1.15fr 0.95fr;
        align-items: center;
        gap: 2rem;
    }

    .hero-text-col {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .hero-main-title-wrap {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .hero-big-title {
        font-family: var(--font-headline);
        font-size: clamp(5.5rem, 11vw, 9rem);
        font-weight: 400;
        line-height: 0.85;
        letter-spacing: 5px;
        color: #ffffff;
        margin: 0;
        text-shadow: 0 0 25px rgba(125, 211, 252, 0.45);
    }

    .hero-category-subtitle {
        font-family: var(--font-body);
        font-size: clamp(0.78rem, 1.8vw, 0.95rem);
        font-weight: 700;
        letter-spacing: 4px;
        color: #cbd5e1;
        text-transform: uppercase;
    }

    .hero-kanji-row {
        display: flex;
        gap: 1.5rem;
        margin: 0.25rem 0;
    }

    .kanji-glyph {
        font-family: var(--font-kanji);
        font-size: clamp(2.2rem, 4.5vw, 3.2rem);
        font-weight: 900;
        color: #ffffff;
        text-shadow: 0 0 16px rgba(255, 255, 255, 0.8);
        line-height: 1;
    }

    .hero-lead-text {
        font-size: 0.98rem;
        line-height: 1.7;
        color: #94a3b8;
        max-width: 480px;
        margin: 0;
    }

    /* Read More button with horizontal decorative line */
    .hero-btn-wrap {
        margin-top: 0.5rem;
    }

    .btn-read-more-line {
        display: inline-flex;
        align-items: center;
        position: relative;
    }

    .btn-read-more {
        display: inline-block;
        padding: 0.45rem 2.2rem;
        border: 1.5px solid #ffffff;
        border-radius: 9999px;
        color: #ffffff;
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        background: rgba(12, 23, 42, 0.6);
        transition: all 0.25s ease;
    }

    .btn-read-more:hover {
        background: #ffffff;
        color: #090e17;
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.6);
    }

    /* Hero Art Col */
    .hero-art-col {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .art-aura-glow {
        position: absolute;
        width: 380px;
        height: 380px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.3) 0%, rgba(14, 165, 233, 0.1) 50%, transparent 70%);
        pointer-events: none;
    }

    .hero-art-frame {
        position: relative;
        z-index: 1;
        width: 320px;
        height: 320px;
        border-radius: 50%;
        padding: 3px;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(56, 189, 248, 0.5));
        box-shadow: 0 0 35px rgba(56, 189, 248, 0.45);
        overflow: hidden;
    }

    .hero-character-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: none;
        box-shadow: none;
    }

    /* ===================================================================
       2. MIDDLE SECTION: BIOGRAPHICAL DOSSIER & STAND-EE
       =================================================================== */
    .dossier-poster-section {
        position: relative;
        background: linear-gradient(180deg, #0e1a2c 0%, #101d30 50%, #0d1727 100%);
        border-bottom: 1px solid rgba(56, 189, 248, 0.25);
        padding: 4rem 2.5rem;
        overflow: hidden;
    }

    /* Ambient Glowing Particles matching layout.jpg */
    .dossier-bg-particles {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 1;
    }

    .dossier-bg-particles .particle {
        position: absolute;
        border-radius: 50%;
        background: #38bdf8;
        box-shadow: 0 0 8px #38bdf8, 0 0 16px rgba(56, 189, 248, 0.6);
        opacity: 0.55;
        animation: floatParticle 8s infinite ease-in-out alternate;
    }

    .p-1 { width: 4px; height: 4px; top: 18%; left: 28%; animation-delay: 0s; }
    .p-2 { width: 5px; height: 5px; top: 42%; left: 78%; animation-delay: 1.5s; }
    .p-3 { width: 3px; height: 3px; top: 72%; left: 35%; animation-delay: 3s; }
    .p-4 { width: 6px; height: 6px; top: 25%; left: 88%; animation-delay: 2s; }
    .p-5 { width: 4px; height: 4px; top: 80%; left: 70%; animation-delay: 4.5s; }
    .p-6 { width: 3px; height: 3px; top: 60%; left: 15%; animation-delay: 0.8s; }

    @keyframes floatParticle {
        0% { transform: translateY(0) scale(1); opacity: 0.3; }
        50% { transform: translateY(-12px) scale(1.3); opacity: 0.75; }
        100% { transform: translateY(-24px) scale(0.9); opacity: 0.4; }
    }

    .dossier-inner {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 280px 1fr 50px;
        gap: 3rem;
        align-items: center;
    }

    /* Standee & Stamp */
    .dossier-standee-col {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .stamp-border-outer {
        border: 2px dashed rgba(255, 255, 255, 0.85);
        border-radius: 50%;
        padding: 3px;
        width: 76px;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(16, 28, 46, 0.95);
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.7);
    }

    .stamp-border-inner {
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 50%;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .stamp-word {
        font-family: var(--font-body);
        font-size: 0.45rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #ffffff;
    }

    .stamp-word-bold {
        font-family: var(--font-headline);
        font-size: 0.95rem;
        font-weight: 400;
        letter-spacing: 1px;
        color: #ffffff;
        line-height: 1;
    }

    .standee-wrapper {
        position: relative;
        width: 260px;
        height: 380px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 1rem 0;
        background: transparent;
        border: none;
        box-shadow: none;
    }

    .standee-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        display: block;
        border: none;
        border-radius: 0;
        box-shadow: none;
        filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.9))
                drop-shadow(0 0 14px rgba(56, 189, 248, 0.55))
                drop-shadow(0 15px 30px rgba(0, 0, 0, 0.85));
    }

    /* Dossier Spec Groups */
    .dossier-data-col {
        display: flex;
        flex-direction: column;
        gap: 2.25rem;
    }

    .dossier-spec-group {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .spec-group-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        position: relative;
    }

    .spec-header-title {
        font-family: var(--font-body);
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        color: #ffffff;
        text-transform: uppercase;
        white-space: nowrap;
        margin: 0;
        line-height: 1;
        text-shadow: 0 0 12px rgba(255, 255, 255, 0.3);
    }

    .spec-items {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding-left: 0;
    }

    .spec-row {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.35rem;
        font-family: var(--font-body);
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .spec-bullet {
        color: #cbd5e1;
        font-weight: 700;
        font-size: 0.95rem;
        margin-right: 2px;
        flex-shrink: 0;
    }

    .spec-label {
        color: #f1f5f9;
        font-weight: 700;
        font-size: 0.92rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .spec-text {
        color: #ffffff;
        font-weight: 500;
        font-size: 0.92rem;
    }

    .highlight-cyan {
        color: #7dd3fc;
        font-weight: 600;
    }

    .font-kanji {
        font-family: var(--font-kanji);
    }

    /* Vertical Icon Dock Strip */
    .dossier-icon-dock {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.75rem;
        padding-left: 0.5rem;
    }

    .dock-icon-btn {
        color: #ffffff;
        opacity: 0.85;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dock-icon-btn:hover {
        opacity: 1;
        color: #38bdf8;
        transform: scale(1.2);
    }

    /* ===================================================================
       3. BOTTOM SECTION: LIFE STORY & ARTWORK SHOWCASE
       =================================================================== */
    .bottom-poster-section {
        background: #0d1726;
        padding: 0 2.5rem 3.5rem;
    }

    .bottom-credit-bar {
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        padding: 0.85rem 0;
        margin-bottom: 2.5rem;
        text-align: left;
    }

    .credit-text {
        font-family: var(--font-body);
        font-size: 0.78rem;
        color: #94a3b8;
        letter-spacing: 0.5px;
    }

    .bottom-inner-grid {
        display: grid;
        grid-template-columns: 200px 1fr 280px;
        gap: 2.5rem;
        align-items: stretch;
    }

    /* Bottom Left: Kanji Logo & Vertical Life Story & 3 Rings */
    .bottom-left-col {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .kanji-logo-header {
        display: flex;
        flex-direction: column;
    }

    .kanji-logo-title {
        font-size: 2.2rem;
        font-weight: 900;
        color: #ffffff;
        line-height: 1;
        letter-spacing: 2px;
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
    }

    .kanji-logo-sub {
        font-size: 0.65rem;
        color: #38bdf8;
        letter-spacing: 2px;
        margin-top: 0.25rem;
    }

    .life-story-milestones-row {
        display: flex;
        gap: 1.25rem;
        align-items: center;
    }

    .vertical-life-story-label {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 3px;
        color: #ffffff;
        white-space: nowrap;
    }

    .expression-thumbnail-rings {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .thumb-ring {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        padding: 2px;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(56, 189, 248, 0.4));
        box-shadow: 0 0 12px rgba(56, 189, 248, 0.3);
    }

    .ring-border {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        overflow: hidden;
    }

    .ring-face-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border: none;
        box-shadow: none;
    }

    /* Bottom Center: Narrative & Dual Capsules */
    .bottom-center-col {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2rem;
    }

    .narrative-text-box p {
        font-size: 0.95rem;
        line-height: 1.8;
        color: #cbd5e1;
        margin-bottom: 1.25rem;
    }

    .dual-capsule-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .capsule-box {
        background: #09121f;
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 9999px;
        padding: 0.75rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .capsule-box:hover {
        border-color: #38bdf8;
        box-shadow: 0 0 15px rgba(56, 189, 248, 0.35);
        transform: translateY(-2px);
    }

    .author-chevron-logo {
        color: #ffffff;
        display: flex;
        align-items: center;
    }

    .author-info {
        display: flex;
        flex-direction: column;
    }

    .author-name {
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 700;
        color: #ffffff;
    }

    .author-role {
        font-size: 0.65rem;
        color: #94a3b8;
    }

    .capsule-design-badge {
        justify-content: center;
        text-align: center;
    }

    .design-badge-info {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .design-badge-sub {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #ffffff;
    }

    .design-badge-main {
        font-family: var(--font-headline);
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: 2px;
        color: #ffffff;
        line-height: 0.9;
    }

    /* Bottom Right: 3 Stacked Artwork Cards */
    .bottom-right-col {
        display: flex;
        flex-direction: column;
    }

    .artwork-cards-stack {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        height: 100%;
        justify-content: space-between;
    }

    .artwork-preview-card {
        position: relative;
        width: 100%;
        height: 92px;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        text-decoration: none;
        transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .artwork-preview-card:hover {
        transform: scale(1.04);
        border-color: #38bdf8;
        box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
    }

    .artwork-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border: none;
        box-shadow: none;
    }

    .artwork-img-fallback {
        width: 100%;
        height: 100%;
        background: #152238;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-headline);
        font-size: 2rem;
        color: #38bdf8;
    }

    .artwork-card-glow-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 0.4rem 0.6rem;
        background: linear-gradient(0deg, rgba(9, 14, 23, 0.9) 0%, transparent 100%);
    }

    .artwork-card-title {
        font-family: var(--font-headline);
        font-size: 0.95rem;
        letter-spacing: 1px;
        color: #ffffff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    /* ── Responsive Breakpoints ───────────────────────────────────────── */
    @media (max-width: 1024px) {
        .hero-inner {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .hero-text-col {
            align-items: center;
        }

        .hero-lead-text {
            max-width: 100%;
        }

        .dossier-inner {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .dossier-icon-dock {
            flex-direction: row;
            padding-left: 0;
            padding-top: 1rem;
