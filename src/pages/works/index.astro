---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";

const allWorks = (await getCollection("works")).sort(
    (a, b) => a.data.order - b.data.order,
);
const featuredWorks = allWorks.filter((w) => w.data.featured);
const otherWorks = allWorks.filter((w) => !w.data.featured);

const tagColors: Record<string, string> = {
    Astro: "#ff3e00",
    Laravel: "#ff2d20",
    "Vue.js": "#42b883",
    TypeScript: "#3178c6",
    PHP: "#777bb4",
    MySQL: "#4479a1",
    Redis: "#dc382d",
    Flutter: "#02569b",
    Dart: "#0175c2",
    Firebase: "#ffca28",
    CSS: "#264de4",
    JAMstack: "#f0047f",
    "REST API": "#6c757d",
    SEO: "#34a853",
    "Tailwind CSS": "#38bdf8",
    "Anime.js": "#e91e63",
    React: "#61dafb",
    "Node.js": "#339933",
    Python: "#3776ab",
    JavaScript: "#f7df1e",
};

function tagColor(tag: string): string {
    return tagColors[tag] ?? "#555";
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`Works | ${SITE_TITLE}`}
            description="Portfolio of projects built by Programer Malas — web apps, APIs, mobile apps, and more."
        />
    </head>
    <body>
        <Header />
        
        <!-- full-bleed is used so global P5 dot background and standard page padding is isolated -->
        <main class="full-bleed p5-works-page">
            <div class="works-container">
                <!-- Page title panel (P5 Slanted Cardboard Header) -->
                <div class="page-title-panel p5-works-title">
                    <div class="action-lines"></div>
                    <div class="title-content">
                        <span class="sfx">MISSION // 01</span>
                        <h1>MY WORKS</h1>
                        <p class="subtitle">
                            Projects I've shipped — from concept to final production.
                        </p>
                    </div>
                </div>

                <!-- Featured projects -->
                {
                    featuredWorks.length > 0 && (
                        <section class="section-block">
                            <div class="section-label-wrapper">
                                <div class="section-label p5-section-label">
                                    ★ FEATURED CLIENTS
                                </div>
                            </div>
                            
                            <div class="works-grid featured-grid">
                                {featuredWorks.map((work, index) => (
                                    <article class={`work-card featured-card card-rotate-${(index % 3) + 1}`}>
                                        {work.data.heroImage ? (
                                            <div class="card-image-wrapper">
                                                <Image
                                                    src={work.data.heroImage}
                                                    alt={`${work.data.title} screenshot`}
                                                    class="card-image"
                                                    widths={[400, 800]}
                                                    sizes="(max-width:640px) 100vw, 400px"
                                                />
                                            </div>
                                        ) : (
                                            <div class="card-image-placeholder">
                                                <span>{work.data.title.charAt(0)}</span>
                                            </div>
                                        )}
                                        
                                        <div class="card-content-p5">
                                            <div class="card-header">
                                                <div class="card-number">
                                                    NO.{(work.data.order ?? index + 1).toString().padStart(2, "0")}
                                                </div>
                                                <div class="featured-badge p5-badge">
                                                    FEATURED_
                                                </div>
                                            </div>
                                            
                                            <h2 class="card-title">
                                                {work.data.title}
                                            </h2>
                                            
                                            <p class="card-desc">
                                                {work.data.description}
                                            </p>
                                            
                                            <div class="tags">
                                                {work.data.tags.map((tag) => (
                                                    <span class="tag p5-tag">
                                                        {tag}
                                                    </span>
                                                ))}
                                            </div>
                                            
                                            <div class="card-actions">
                                                {work.data.link && (
                                                    <a
                                                        href={work.data.link}
                                                        target="_blank"
                                                        rel="noopener"
                                                        class="btn-p5-work btn-primary"
                                                    >
                                                        LIVE DEMO
                                                    </a>
                                                )}
                                                {work.data.github && (
                                                    <a
                                                        href={work.data.github}
                                                        target="_blank"
                                                        rel="noopener"
                                                        class="btn-p5-work btn-secondary"
                                                    >
                                                        GITHUB
                                                    </a>
                                                )}
                                                <a
                                                    href={`/works/${work.id}`}
                                                    class="btn-p5-work btn-outline"
                                                >
                                                    MORE ➤
                                                </a>
                                            </div>
                                        </div>
                                    </article>
                                ))}
                            </div>
                        </section>
                    )
                }
            </div>
        </main>
        
        <Footer />
    </body>
</html>

<style>
    :root {
        --p5-red: #e60012;
        --p5-black: #000000;
        --p5-white: #ffffff;
        --p5-dark-gray: #151515;
    }

    .p5-works-page {
        background-color: var(--p5-black);
        min-height: 100vh;
        padding: 11rem 2rem 6rem;
        overflow: hidden; /* Prevent rotated cards from causing side overflows */
    }

    .works-container {
        max-width: 1300px;
        margin: 0 auto;
        width: 100%;
    }

    /* ── P5 Slanted Title Panel ── */
    .page-title-panel.p5-works-title {
        border: 4px solid var(--p5-white);
        background: var(--p5-black);
        box-shadow: 10px 10px 0 var(--p5-red);
        position: relative;
        overflow: hidden;
        padding: 4rem 3rem;
        margin-bottom: 5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: rotate(-1.5deg) skewX(-6deg);
    }

    .action-lines {
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            45deg,
            transparent,
            transparent 10px,
            rgba(230, 0, 18, 0.08) 10px,
            rgba(230, 0, 18, 0.08) 20px
        );
        pointer-events: none;
    }

    .title-content {
        position: relative;
        z-index: 2;
        text-align: center;
        transform: skewX(6deg) rotate(1.5deg); /* Counter skew */
    }

    .sfx {
        font-family: "Space Grotesk", sans-serif;
        font-size: 0.8rem;
        font-weight: 900;
        letter-spacing: 4px;
        color: var(--p5-red);
        display: block;
        margin-bottom: 0.5rem;
    }

    h1 {
        font-family: "Bangers", cursive;
        font-size: clamp(3rem, 7vw, 5.5rem);
        color: var(--p5-white);
        text-shadow: 5px 5px 0 var(--p5-red);
        margin: 0;
        line-height: 0.9;
        letter-spacing: 2px;
    }

    .subtitle {
        color: #d1cde3;
        font-family: "Outfit", sans-serif;
        font-size: 1.05rem;
        margin: 1rem 0 0;
        opacity: 0.9;
    }

    /* ── P5 Section Label ── */
    .section-block {
        margin-bottom: 5rem;
    }

    .section-label-wrapper {
        margin-bottom: 3rem;
    }

    .section-label.p5-section-label {
        font-family: "Space Grotesk", sans-serif;
        font-size: 1.1rem;
        font-weight: 900;
        letter-spacing: 2px;
        background: var(--p5-red);
        color: var(--p5-white);
        border: 2px solid var(--p5-white);
        padding: 0.5rem 2rem;
        display: inline-block;
        transform: rotate(-2deg) skewX(-10deg);
        box-shadow: 5px 5px 0 var(--p5-black);
    }

    /* ── Works Grid ── */
    .works-grid {
        display: grid;
        gap: 3rem;
    }

    .featured-grid {
        /* FIX: Use min(100%, 320px) to prevent card elements from overflowing small screen viewports */
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    }

    /* ── P5 Stylized Cards ── */
    .work-card {
        border: 4px solid var(--p5-white);
        background: var(--p5-dark-gray);
        box-shadow: 10px 10px 0 var(--p5-red);
        display: flex;
        flex-direction: column;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
    }

    /* Individual Card Rotations for chaotic P5 alignment */
    .card-rotate-1 { transform: rotate(-1.5deg); }
    .card-rotate-2 { transform: rotate(1deg); }
    .card-rotate-3 { transform: rotate(-0.5deg); }

    .work-card:hover {
        transform: scale(1.03) rotate(0deg);
        box-shadow: 0 0 35px var(--p5-red);
        z-index: 10;
        border-color: var(--p5-red);
    }

    .card-image-wrapper {
        width: 100%;
        overflow: hidden;
        border-bottom: 4px solid var(--p5-white);
        position: relative;
    }

    .card-image {
        width: 100%;
        height: 230px;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }

    .work-card:hover .card-image {
        transform: scale(1.05);
    }

    .card-image-placeholder {
        width: 100%;
        height: 230px;
        background: repeating-linear-gradient(
            45deg,
            #111,
            #111 15px,
            #222 15px,
            #222 30px
        );
        border-bottom: 4px solid var(--p5-white);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-image-placeholder span {
        font-family: "Bangers", cursive;
        font-size: 6rem;
        color: var(--p5-white);
        opacity: 0.1;
    }

    .card-content-p5 {
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        flex: 1;
    }

    /* Card header row */
    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .card-number {
        font-family: "Bangers", cursive;
        font-size: 1.2rem;
        color: #8b83a3;
        letter-spacing: 2px;
    }

    .featured-badge.p5-badge {
        font-family: "Space Grotesk", sans-serif;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 2px;
        background: var(--p5-red);
        color: var(--p5-white);
        border: 2px solid var(--p5-white);
        padding: 3px 10px;
        box-shadow: 3px 3px 0 var(--p5-black);
        transform: rotate(2deg) skewX(8deg);
    }

    /* Card title */
    .card-title {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 900;
        font-size: 1.6rem;
        margin: 0;
        color: var(--p5-white);
        line-height: 1.1;
        text-shadow: 2px 2px 0 var(--p5-red);
    }

    /* Card description */
    .card-desc {
        font-family: "Outfit", sans-serif;
        font-size: 0.92rem;
        color: #d1cde3;
        margin: 0;
        line-height: 1.7;
        flex: 1;
    }

    /* P5 Tags */
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag.p5-tag {
        font-family: "Space Grotesk", sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: var(--p5-white);
        background: var(--p5-black);
        padding: 4px 10px;
        border: 2px solid var(--p5-white);
        transform: skewX(-10deg);
        box-shadow: 3px 3px 0 var(--p5-red);
    }

    /* P5 Button Layout in Card */
    .card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 1rem;
    }

    .btn-p5-work {
        display: inline-flex;
        align-items: center;
        font-family: "Space Grotesk", sans-serif;
        font-weight: 900;
        font-size: 0.8rem;
        letter-spacing: 1.5px;
        padding: 8px 18px;
        border: 2px solid var(--p5-white);
        text-decoration: none;
        box-shadow: 4px 4px 0 var(--p5-black);
        transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        cursor: pointer;
        transform: skewX(-10deg);
    }

    .btn-p5-work:hover {
        transform: skewX(-10deg) scale(1.05);
    }

    .btn-primary {
        background: var(--p5-red);
        color: var(--p5-white);
        box-shadow: 4px 4px 0 var(--p5-black);
    }

    .btn-primary:hover {
        background: var(--p5-white);
        color: var(--p5-black);
        border-color: var(--p5-black);
        box-shadow: -4px 4px 0 var(--p5-red);
    }

    .btn-secondary {
        background: var(--p5-black);
        color: var(--p5-white);
    }

    .btn-secondary:hover {
        background: var(--p5-red);
        color: var(--p5-white);
        box-shadow: -4px 4px 0 var(--p5-black);
    }

    .btn-outline {
        background: transparent;
        color: var(--p5-white);
    }

    .btn-outline:hover {
        background: var(--p5-white);
        color: var(--p5-black);
        border-color: var(--p5-black);
        box-shadow: -4px 4px 0 var(--p5-red);
    }

    /* ── Responsive ── */
    @media (max-width: 992px) {
        .p5-works-page {
            padding: 5rem 1rem 4rem;
        }

        /* FIX: Reset title panel skew and margins on mobile/tablets to prevent horizontal scroll */
        .page-title-panel.p5-works-title {
            margin-bottom: 3rem;
            padding: 3rem 1.5rem;
            transform: none;
            box-shadow: 6px 6px 0 var(--p5-red);
        }

        .title-content {
            transform: none;
        }
    }

    @media (max-width: 640px) {
        .featured-grid {
            grid-template-columns: 1fr;
        }

        .work-card {
            transform: none !important;
        }
    }
</style>
