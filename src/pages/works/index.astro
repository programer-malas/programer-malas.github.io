---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";

const allWorks = (await getCollection("works")).sort(
    (a, b) => a.data.order - b.data.order,
);
const featuredWorks = allWorks.filter((w) => w.data.featured);
const otherWorks = allWorks.filter((w) => !w.data.featured);

const tagColors: Record<string, string> = {
    Astro: "rgba(255, 62, 0, 0.2)",
    Laravel: "rgba(255, 45, 32, 0.2)",
    "Vue.js": "rgba(66, 184, 131, 0.2)",
    TypeScript: "rgba(49, 120, 198, 0.2)",
    PHP: "rgba(119, 123, 180, 0.2)",
    MySQL: "rgba(68, 121, 161, 0.2)",
    Redis: "rgba(220, 56, 45, 0.2)",
    Flutter: "rgba(2, 86, 155, 0.2)",
    Dart: "rgba(1, 117, 194, 0.2)",
    Firebase: "rgba(255, 202, 40, 0.2)",
    CSS: "rgba(38, 77, 228, 0.2)",
    JAMstack: "rgba(240, 4, 127, 0.2)",
    "REST API": "rgba(108, 117, 125, 0.2)",
    SEO: "rgba(52, 168, 83, 0.2)",
    "Tailwind CSS": "rgba(56, 189, 248, 0.2)",
    "Anime.js": "rgba(233, 30, 99, 0.2)",
    React: "rgba(97, 218, 251, 0.2)",
    "Node.js": "rgba(51, 153, 51, 0.2)",
    Python: "rgba(55, 118, 171, 0.2)",
    JavaScript: "rgba(247, 223, 30, 0.2)",
};

const tagBorderColors: Record<string, string> = {
    Astro: "#ff3e00",
    Laravel: "#ff2d20",
    "Vue.js": "#42b883",
    TypeScript: "#3178c6",
    PHP: "#777bb4",
    MySQL: "#4479a1",
    Redis: "#dc382d",
    Flutter: "#02569b",
    Dart: "#0175c2",
    Firebase: "#ffca28",
    CSS: "#264de4",
    JAMstack: "#f0047f",
    "REST API": "#6c757d",
    SEO: "#34a853",
    "Tailwind CSS": "#38bdf8",
    "Anime.js": "#e91e63",
    React: "#61dafb",
    "Node.js": "#339933",
    Python: "#3776ab",
    JavaScript: "#f7df1e",
};

function tagBg(tag: string): string {
    return tagColors[tag] ?? "rgba(56, 189, 248, 0.15)";
}

function tagBorder(tag: string): string {
    return tagBorderColors[tag] ?? "var(--cyan-light)";
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`Works & Projects | ${SITE_TITLE}`}
            description="Portfolio of production software, systems, and web apps built by Programer Malas."
        />
    </head>
    <body>
        <Header />
        <main class="works-main-wrapper">
            <!-- Page Title Panel (Cyber HUD Banner) -->
            <div class="works-hero hud-panel">
                <div class="works-hero-glow"></div>
                <div class="works-hero-content">
                    <div class="works-hero-tag">
                        <span class="pulse-indicator"></span>
                        <span>SYSTEM ARCHIVE // SHIPPED PROJECTS</span>
                    </div>
                    <h1>ENGINEERING WORKS</h1>
                    <p class="works-hero-desc">
                        Production applications, distributed backend services, and scalable web architectures built with modern stacks.
                    </p>
                </div>
            </div>

            <!-- Featured Projects Section -->
            {
                featuredWorks.length > 0 && (
                    <section class="works-section">
                        <div class="section-header">
                            <div class="section-title-wrap">
                                <h2>FEATURED DOSSIERS</h2>
                            </div>
                            <div class="section-line"></div>
                        </div>

                        <div class="works-grid featured-grid">
                            {featuredWorks.map((work) => (
                                <article class="work-card hud-panel">
                                    <div class="card-image-box">
                                        {work.data.heroImage ? (
                                            <Image
                                                src={work.data.heroImage}
                                                alt={`${work.data.title} screenshot`}
                                                class="card-image"
                                                widths={[400, 800]}
                                                sizes="(max-width:640px) 100vw, 400px"
                                            />
                                        ) : (
                                            <div class="card-placeholder">
                                                <span>{work.data.title.charAt(0)}</span>
                                            </div>
                                        )}
                                        <div class="card-order-badge">
                                            #{work.data.order.toString().padStart(2, "0")}
                                        </div>
                                    </div>

                                    <div class="card-body">
                                        <div class="card-status-row">
                                            <span class="badge-featured">FEATURED</span>
                                            {work.data.link && (
                                                <span class="badge-live">ONLINE</span>
                                            )}
                                        </div>

                                        <h3 class="card-title">
                                            <a href={`/works/${work.id}`}>{work.data.title}</a>
                                        </h3>

                                        <p class="card-desc">
                                            {work.data.description}
                                        </p>

                                        {work.data.tags && work.data.tags.length > 0 && (
                                            <div class="card-tags">
                                                {work.data.tags.map((tag) => (
                                                    <span
                                                        class="cyber-tag"
                                                        style={`background:${tagBg(tag)}; border-color:${tagBorder(tag)}; color:${tagBorder(tag)}`}
                                                    >
                                                        {tag}
                                                    </span>
                                                ))}
                                            </div>
                                        )}

                                        <div class="card-footer-actions">
                                            <a
                                                href={`/works/${work.id}`}
                                                class="btn-cyber btn-card-details"
                                            >
                                                <span>DETAIL</span>
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                            </a>

                                            <div class="card-ext-links">
                                                {work.data.link && (
                                                    <a
                                                        href={work.data.link}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="icon-link-btn"
                                                        title="Live Project"
                                                    >
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                                    </a>
                                                )}
                                                {work.data.github && (
                                                    <a
                                                        href={work.data.github}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="icon-link-btn"
                                                        title="GitHub Repository"
                                                    >
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                                                    </a>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            ))}
                        </div>
                    </section>
                )
            }

            <!-- Other Projects Section -->
            {
                otherWorks.length > 0 && (
                    <section class="works-section">
                        <div class="section-header">
                            <div class="section-title-wrap">
                                <span class="section-icon">📁</span>
                                <h2>ARCHIVED SYSTEMS</h2>
                            </div>
                            <div class="section-line"></div>
                        </div>

                        <div class="works-grid other-grid">
                            {otherWorks.map((work) => (
                                <article class="work-card hud-panel">
                                    <div class="card-body">
                                        <div class="card-status-row">
                                            <span class="card-order-badge-mini">#{work.data.order.toString().padStart(2, "0")}</span>
                                        </div>
                                        <h3 class="card-title">
                                            <a href={`/works/${work.id}`}>{work.data.title}</a>
                                        </h3>
                                        <p class="card-desc">
                                            {work.data.description}
                                        </p>
                                        <div class="card-footer-actions">
                                            <a
                                                href={`/works/${work.id}`}
                                                class="btn-cyber btn-card-details"
                                            >
                                                <span>DOSSIER →</span>
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            ))}
                        </div>
                    </section>
                )
            }
        </main>
        <Footer />
    </body>
</html>

<style>
    .works-main-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
    }

    /* ── Hero Panel ───────────────────────────────────────────────── */
    .works-hero {
        position: relative;
        padding: 3.5rem 3rem;
        background: linear-gradient(135deg, rgba(13, 21, 39, 0.95), rgba(7, 11, 20, 0.98));
        border: 1px solid var(--border-cyan);
        border-radius: 6px;
        overflow: hidden;
    }

    .works-hero-glow {
        position: absolute;
        top: -50%;
        left: 30%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.18) 0%, transparent 70%);
        pointer-events: none;
    }

    .works-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .works-hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--cyan-light);
        letter-spacing: 1.5px;
    }

    .pulse-indicator {
        width: 8px;
        height: 8px;
        background: var(--cyan-neon);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--cyan-neon);
    }

    .works-hero h1 {
        font-family: var(--font-title);
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 900;
        letter-spacing: 3px;
        color: var(--white);
        margin: 0;
        text-shadow: 0 0 25px rgba(56, 189, 248, 0.35);
    }

    .works-hero-desc {
        font-size: 1.05rem;
        color: var(--text-sub);
        max-width: 600px;
        margin: 0;
        line-height: 1.7;
    }

    /* ── Sections ─────────────────────────────────────────────────── */
    .works-section {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .section-title-wrap {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .section-icon {
        font-size: 1.2rem;
    }

    .section-header h2 {
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: var(--white);
        margin: 0;
        white-space: nowrap;
    }

    .section-line {
        height: 1px;
        flex-grow: 1;
        background: linear-gradient(90deg, var(--border-cyan-bright), transparent);
    }

    /* ── Grids ────────────────────────────────────────────────────── */
    .works-grid {
        display: grid;
        gap: 2rem;
    }

    .featured-grid {
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    }

    .other-grid {
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }

    /* ── Cards ────────────────────────────────────────────────────── */
    .work-card {
        background: rgba(13, 21, 39, 0.85);
        border: 1px solid var(--border-cyan);
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .work-card:hover {
        border-color: var(--cyan-light);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7), var(--glow-cyan-sm);
        transform: translateY(-4px);
    }

    .card-image-box {
        position: relative;
        width: 100%;
        height: 210px;
        background: var(--bg-deep);
        overflow: hidden;
        border-bottom: 1px solid var(--border-cyan);
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border: none;
        box-shadow: none;
        transition: transform 0.4s ease;
    }

    .work-card:hover .card-image {
        transform: scale(1.05);
    }

    .card-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(56, 189, 248, 0.05);
        font-family: var(--font-display);
        font-size: 4rem;
        color: var(--cyan-light);
        opacity: 0.3;
    }

    .card-order-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(7, 11, 20, 0.85);
        border: 1px solid var(--border-cyan);
        color: var(--cyan-light);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 4px;
        backdrop-filter: blur(8px);
    }

    .card-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex-grow: 1;
    }

    .card-status-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .badge-featured {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1px;
        background: rgba(129, 140, 248, 0.15);
        color: var(--accent-purple);
        border: 1px solid var(--accent-purple);
        padding: 2px 8px;
        border-radius: 4px;
    }

    .badge-live {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1px;
        background: rgba(16, 185, 129, 0.15);
        color: var(--accent-emerald);
        border: 1px solid var(--accent-emerald);
        padding: 2px 8px;
        border-radius: 4px;
    }

    .card-order-badge-mini {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--cyan-light);
        font-weight: 700;
    }

    .card-title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .card-title a {
        color: var(--white);
        text-decoration: none;
    }

    .card-title a:hover {
        color: var(--cyan-neon);
    }

    .card-desc {
        font-size: 0.92rem;
        color: var(--text-sub);
        line-height: 1.6;
        margin: 0;
        flex-grow: 1;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .cyber-tag {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        padding: 2px 8px;
        border: 1px solid;
        border-radius: 4px;
        letter-spacing: 0.5px;
    }

    .card-footer-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .btn-card-details {
        padding: 0.45rem 1.1rem;
        font-size: 0.82rem;
        border-radius: 9999px;
    }

    .card-ext-links {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .icon-link-btn {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        border: 1px solid var(--border-cyan);
        background: rgba(56, 189, 248, 0.05);
        color: var(--text-sub);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .icon-link-btn:hover {
        border-color: var(--cyan-light);
        color: var(--cyan-neon);
        box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
    }

    @media (max-width: 640px) {
        .works-main-wrapper {
            padding: 1.5rem 1rem;
        }

        .works-hero {
            padding: 2rem 1.25rem;
        }

        .featured-grid,
        .other-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
