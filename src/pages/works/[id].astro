---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
    const works = await getCollection('works');
    return works.map((work) => ({
        params: { id: work.id },
        props: { work },
    }));
}

const { work } = Astro.props;
const { Content } = await render(work);

const tagColors: Record<string, string> = {
    Astro: "rgba(255, 62, 0, 0.2)",
    Laravel: "rgba(255, 45, 32, 0.2)",
    "Vue.js": "rgba(66, 184, 131, 0.2)",
    TypeScript: "rgba(49, 120, 198, 0.2)",
    PHP: "rgba(119, 123, 180, 0.2)",
    MySQL: "rgba(68, 121, 161, 0.2)",
    Redis: "rgba(220, 56, 45, 0.2)",
    Flutter: "rgba(2, 86, 155, 0.2)",
    Dart: "rgba(1, 117, 194, 0.2)",
    Firebase: "rgba(255, 202, 40, 0.2)",
    CSS: "rgba(38, 77, 228, 0.2)",
    JAMstack: "rgba(240, 4, 127, 0.2)",
    "REST API": "rgba(108, 117, 125, 0.2)",
    SEO: "rgba(52, 168, 83, 0.2)",
    "Tailwind CSS": "rgba(56, 189, 248, 0.2)",
    "Anime.js": "rgba(233, 30, 99, 0.2)",
    React: "rgba(97, 218, 251, 0.2)",
    "Node.js": "rgba(51, 153, 51, 0.2)",
    Python: "rgba(55, 118, 171, 0.2)",
    JavaScript: "rgba(247, 223, 30, 0.2)",
};

const tagBorderColors: Record<string, string> = {
    Astro: "#ff3e00",
    Laravel: "#ff2d20",
    "Vue.js": "#42b883",
    TypeScript: "#3178c6",
    PHP: "#777bb4",
    MySQL: "#4479a1",
    Redis: "#dc382d",
    Flutter: "#02569b",
    Dart: "#0175c2",
    Firebase: "#ffca28",
    CSS: "#264de4",
    JAMstack: "#f0047f",
    "REST API": "#6c757d",
    SEO: "#34a853",
    "Tailwind CSS": "#38bdf8",
    "Anime.js": "#e91e63",
    React: "#61dafb",
    "Node.js": "#339933",
    Python: "#3776ab",
    JavaScript: "#f7df1e",
};

function tagBg(tag: string): string {
    return tagColors[tag] ?? "rgba(56, 189, 248, 0.15)";
}

function tagBorder(tag: string): string {
    return tagBorderColors[tag] ?? "var(--cyan-light)";
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${work.data.title} | ${SITE_TITLE}`}
            description={work.data.description}
        />
    </head>
    <body>
        <Header />
        <main class="work-detail-wrapper">
            <!-- Back Navigation Link -->
            <div class="back-link-row">
                <a href="/works" class="back-cyber-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    <span>RETURN TO ARCHIVES</span>
                </a>
            </div>

            <!-- Project Hero Dossier Header -->
            <div class="work-hero-panel hud-panel">
                <div class="work-hero-glow"></div>
                <div class="work-hero-content">
                    <div class="hero-meta-row">
                        <span class="meta-dossier-id">DOSSIER // #{work.data.order.toString().padStart(2, "0")}</span>
                        {work.data.featured && <span class="badge-featured">FEATURED SYSTEM</span>}
                    </div>

                    <h1 class="work-title">{work.data.title}</h1>
                    <p class="work-desc">{work.data.description}</p>

                    {work.data.tags && work.data.tags.length > 0 && (
                        <div class="tags-row">
                            {work.data.tags.map((tag) => (
                                <span
                                    class="cyber-tag"
                                    style={`background:${tagBg(tag)}; border-color:${tagBorder(tag)}; color:${tagBorder(tag)}`}
                                >
                                    {tag}
                                </span>
                            ))}
                        </div>
                    )}

                    <div class="hero-actions-row">
                        {work.data.link && (
                            <a href={work.data.link} target="_blank" rel="noopener noreferrer" class="btn-cyber btn-cyber-solid">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                <span>LAUNCH SYSTEM</span>
                            </a>
                        )}
                        {work.data.github && (
                            <a href={work.data.github} target="_blank" rel="noopener noreferrer" class="btn-cyber">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                                <span>SOURCE CODE</span>
                            </a>
                        )}
                    </div>
                </div>
            </div>

            <!-- Screenshot Frame -->
            {work.data.heroImage && (
                <div class="screenshot-panel hud-panel">
                    <div class="screenshot-telemetry-bar">
                        <span class="telemetry-dot"></span>
                        <span class="telemetry-label">SYSTEM PREVIEW & INTERFACE CAPTURE</span>
                    </div>
                    <Image
                        src={work.data.heroImage}
                        alt={`${work.data.title} screenshot`}
                        class="screenshot-img"
                        widths={[800, 1200]}
                        sizes="(max-width:640px) 100vw, 960px"
                    />
                </div>
            )}

            <!-- Technical Specification Body (Prose) -->
            <div class="doc-body-panel hud-panel">
                <div class="prose-content">
                    <Content />
                </div>
            </div>
        </main>
        <Footer />
    </body>
</html>

<style>
    .work-detail-wrapper {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .back-link-row {
        margin-bottom: 0.5rem;
    }

    .back-cyber-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.82rem;
        letter-spacing: 1px;
        color: var(--cyan-light);
        text-decoration: none;
        padding: 0.35rem 0.85rem;
        background: rgba(56, 189, 248, 0.05);
        border: 1px solid var(--border-cyan);
        border-radius: 4px;
        transition: all 0.2s ease;
    }

    .back-cyber-link:hover {
        background: rgba(56, 189, 248, 0.15);
        color: var(--cyan-neon);
        border-color: var(--cyan-light);
        box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
        transform: translateX(-3px);
    }

    /* ── Hero Panel ───────────────────────────────────────────────── */
    .work-hero-panel {
        padding: 3rem 2.5rem;
        background: linear-gradient(135deg, rgba(13, 21, 39, 0.95), rgba(7, 11, 20, 0.98));
        border: 1px solid var(--border-cyan);
        border-radius: 6px;
        position: relative;
        overflow: hidden;
    }

    .work-hero-glow {
        position: absolute;
        top: -40%;
        right: -20%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.2) 0%, transparent 70%);
        pointer-events: none;
    }

    .work-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .hero-meta-row {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .meta-dossier-id {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 1.5px;
        color: var(--cyan-light);
    }

    .badge-featured {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1px;
        background: rgba(129, 140, 248, 0.15);
        color: var(--accent-purple);
        border: 1px solid var(--accent-purple);
        padding: 2px 8px;
        border-radius: 4px;
    }

    .work-title {
        font-family: var(--font-title);
        font-size: clamp(2.2rem, 5vw, 3.5rem);
        font-weight: 900;
        color: var(--white);
        margin: 0;
        letter-spacing: 2px;
        line-height: 1.1;
        text-shadow: 0 0 25px rgba(56, 189, 248, 0.35);
    }

    .work-desc {
        font-size: 1.05rem;
        color: var(--text-sub);
        line-height: 1.7;
        margin: 0;
        max-width: 760px;
    }

    .tags-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: 0.25rem;
    }

    .cyber-tag {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        padding: 2px 8px;
        border: 1px solid;
        border-radius: 4px;
        letter-spacing: 0.5px;
    }

    .hero-actions-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 0.75rem;
    }

    /* ── Screenshot Panel ─────────────────────────────────────────── */
    .screenshot-panel {
        background: var(--bg-deep);
        border: 1px solid var(--border-cyan);
        border-radius: 6px;
        overflow: hidden;
    }

    .screenshot-telemetry-bar {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.6rem 1.25rem;
        background: rgba(7, 11, 20, 0.95);
        border-bottom: 1px solid var(--border-cyan);
    }

    .telemetry-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--cyan-light);
        box-shadow: 0 0 6px var(--cyan-light);
    }

    .telemetry-label {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--text-muted);
        letter-spacing: 1px;
    }

    .screenshot-img {
        width: 100%;
        height: auto;
        display: block;
        border: none;
        box-shadow: none;
        max-height: 580px;
        object-fit: cover;
        object-position: top;
    }

    /* ── Content Body (Prose) ─────────────────────────────────────── */
    .doc-body-panel {
        padding: 2.5rem;
        background: rgba(13, 21, 39, 0.85);
        border: 1px solid var(--border-cyan);
        border-radius: 6px;
    }

    .prose-content {
        line-height: 1.8;
        font-size: 1rem;
        color: var(--text-sub);
    }

    .prose-content :global(h2),
    .prose-content :global(h3) {
        font-family: var(--font-display);
        color: var(--white);
        letter-spacing: 1px;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        border-left: 3px solid var(--cyan-light);
        padding-left: 0.75rem;
    }

    .prose-content :global(h2) {
        font-size: 1.6rem;
    }

    .prose-content :global(h3) {
        font-size: 1.3rem;
    }

    .prose-content :global(p) {
        margin-bottom: 1.25rem;
    }

    .prose-content :global(ul),
    .prose-content :global(ol) {
        padding-left: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .prose-content :global(li) {
        margin-bottom: 0.4rem;
    }

    .prose-content :global(strong) {
        color: var(--cyan-light);
    }

    @media (max-width: 640px) {
        .work-detail-wrapper {
            padding: 1.5rem 1rem;
        }

        .work-hero-panel {
            padding: 1.75rem 1.25rem;
        }

        .doc-body-panel {
            padding: 1.5rem 1rem;
        }
    }
</style>

