---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="article-main-wrapper">
			<div class="back-link-row">
				<a href="/blog" class="back-cyber-link">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
					<span>RETURN TO TRANSMISSIONS</span>
				</a>
			</div>

			<article class="article-container hud-panel">
				<!-- Article Header -->
				<header class="article-header">
					<div class="article-meta">
						<span class="meta-dot"></span>
						<span class="meta-date">
							<FormattedDate date={pubDate} />
						</span>
						{
							updatedDate && (
								<span class="meta-updated">
									(Updated: <FormattedDate date={updatedDate} />)
								</span>
							)
						}
					</div>
					<h1 class="article-title">{title}</h1>
					<div class="header-divider"></div>
				</header>

				<!-- Hero Image Frame -->
				{
					heroImage && (
						<div class="article-hero-frame">
							<Image
								width={1020}
								height={510}
								src={heroImage}
								alt=""
								class="article-hero-img"
							/>
						</div>
					)
				}

				<!-- Article Body Content -->
				<div class="article-body">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-main-wrapper {
		max-width: 900px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.back-link-row {
		margin-bottom: 0.25rem;
	}

	.back-cyber-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		letter-spacing: 1px;
		color: var(--cyan-light);
		text-decoration: none;
		padding: 0.35rem 0.85rem;
		background: rgba(56, 189, 248, 0.05);
		border: 1px solid var(--border-cyan);
		border-radius: 4px;
		transition: all 0.2s ease;
	}

	.back-cyber-link:hover {
		background: rgba(56, 189, 248, 0.15);
		color: var(--cyan-neon);
		border-color: var(--cyan-light);
		box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
		transform: translateX(-3px);
	}

	.article-container {
		padding: 3rem 2.5rem;
		background: rgba(13, 21, 39, 0.9);
		border: 1px solid var(--border-cyan);
		border-radius: 6px;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.article-header {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--cyan-light);
	}

	.meta-dot {
		width: 6px;
		height: 6px;
		background: var(--cyan-neon);
		border-radius: 50%;
		box-shadow: 0 0 6px var(--cyan-neon);
	}

	.meta-updated {
		color: var(--text-muted);
		font-style: italic;
	}

	.article-title {
		font-family: var(--font-title);
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		font-weight: 900;
		color: var(--white);
		margin: 0;
		letter-spacing: 1.5px;
		line-height: 1.15;
		text-shadow: 0 0 25px rgba(56, 189, 248, 0.35);
	}

	.header-divider {
		height: 1px;
		background: linear-gradient(90deg, var(--border-cyan-bright), transparent);
		margin-top: 0.75rem;
	}

	.article-hero-frame {
		width: 100%;
		border-radius: 6px;
		overflow: hidden;
		border: 1px solid var(--border-cyan);
		background: var(--bg-deep);
	}

	.article-hero-img {
		width: 100%;
		height: auto;
		display: block;
		border: none;
		box-shadow: none;
		max-height: 460px;
		object-fit: cover;
	}

	.article-body {
		line-height: 1.85;
		font-size: 1.05rem;
		color: var(--text-sub);
	}

	.article-body :global(h2),
	.article-body :global(h3) {
		font-family: var(--font-display);
		color: var(--white);
		letter-spacing: 1px;
		margin-top: 2.25rem;
		margin-bottom: 0.85rem;
		border-left: 3px solid var(--cyan-light);
		padding-left: 0.75rem;
	}

	.article-body :global(h2) {
		font-size: 1.7rem;
	}

	.article-body :global(h3) {
		font-size: 1.35rem;
	}

	.article-body :global(p) {
		margin-bottom: 1.35rem;
	}

	.article-body :global(ul),
	.article-body :global(ol) {
		padding-left: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.article-body :global(li) {
		margin-bottom: 0.4rem;
	}

	.article-body :global(strong) {
		color: var(--cyan-light);
	}

	@media (max-width: 640px) {
		.article-main-wrapper {
			padding: 1.5rem 1rem;
		}

		.article-container {
			padding: 1.75rem 1.25rem;
		}
	}
</style>

