---
import { SITE_TITLE } from "../consts";
---

<header class="poster-navbar">
    <div class="nav-inner">
        <!-- Left: Brand Logo -->
        <a href="/" class="nav-logo-link" aria-label="Home">
            <img
                src="/avatar/logo.webp"
                alt="Programer Malas Logo"
                class="nav-logo-img"
            />
        </a>
        <!-- Right: Hamburger Menu Icon -->
        <button id="nav-toggle" class="nav-hamburger" aria-label="Toggle Menu">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>
    </div>

    <!-- Mobile Drawer -->
    <div id="nav-mobile-drawer" class="mobile-nav-drawer">
        <a href="#hero" class="mobile-nav-item">Home</a>
        <a href="/works" class="mobile-nav-item">Works</a>
        <a href="/blog" class="mobile-nav-item">Blog</a>
    </div>
</header>

<script>
    const btn = document.getElementById("nav-toggle");
    const drawer = document.getElementById("nav-mobile-drawer");
    if (btn && drawer) {
        btn.addEventListener("click", () => {
            drawer.classList.toggle("open");
            btn.classList.toggle("active");
        });
    }
</script>

<style>
    .poster-navbar {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(12, 20, 34, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(56, 189, 248, 0.18);
        width: 100%;
    }

    .nav-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0.75rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Left Logo */
    .nav-logo-link {
        display: flex;
        align-items: center;
        text-decoration: none;
        transition: transform 0.2s ease;
    }

    .nav-logo-link:hover {
        transform: scale(1.05);
    }

    .nav-logo-img {
        height: 38px;
        width: auto;
        max-width: 130px;
        object-fit: contain;
        display: block;
        filter: drop-shadow(1.5px 0 0 #000000)
                drop-shadow(-1.5px 0 0 #000000)
                drop-shadow(0 1.5px 0 #000000)
                drop-shadow(0 -1.5px 0 #000000)
                drop-shadow(1px 1px 0 #000000)
                drop-shadow(-1px -1px 0 #000000)
                drop-shadow(1px -1px 0 #000000)
                drop-shadow(-1px 1px 0 #000000);
        transition: filter 0.2s ease;
    }

    .nav-logo-link:hover .nav-logo-img {
        filter: drop-shadow(2px 0 0 #000000)
                drop-shadow(-2px 0 0 #000000)
                drop-shadow(0 2px 0 #000000)
                drop-shadow(0 -2px 0 #000000)
                drop-shadow(1.5px 1.5px 0 #000000)
                drop-shadow(-1.5px -1.5px 0 #000000)
                drop-shadow(1.5px -1.5px 0 #000000)
                drop-shadow(-1.5px 1.5px 0 #000000)
                drop-shadow(0 0 8px rgba(0, 0, 0, 0.9));
    }

    /* Center Nav Items */
    .nav-menu {
        display: flex;
        align-items: center;
        gap: 3.5rem;
    }

    .nav-link {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.95rem;
        font-weight: 500;
        color: #cbd5e1;
        text-decoration: none;
        padding: 0.35rem 1rem;
        border-radius: 9999px;
        transition: all 0.2s ease;
        letter-spacing: 0.3px;
    }

    .nav-link:hover {
        color: #ffffff;
        background: rgba(56, 189, 248, 0.12);
    }

    .nav-link.active {
        color: #ffffff;
        background: rgba(56, 189, 248, 0.2);
        box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
    }

    /* Right Hamburger Icon */
    .nav-hamburger {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 24px;
        height: 18px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
    }

    .hamburger-line {
        width: 100%;
        height: 2px;
        background: #ffffff;
        border-radius: 2px;
        transition: all 0.25s ease;
    }

    .nav-hamburger:hover .hamburger-line {
        background: #38bdf8;
    }

    /* Mobile Drawer */
    .mobile-nav-drawer {
        display: none;
        flex-direction: column;
        background: rgba(10, 16, 28, 0.98);
        border-bottom: 1px solid rgba(56, 189, 248, 0.2);
        padding: 1rem 2rem;
        gap: 0.75rem;
    }

    .mobile-nav-drawer.open {
        display: flex;
    }

    .mobile-nav-item {
        font-size: 1rem;
        color: #e2e8f0;
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        text-decoration: none;
    }

    .mobile-nav-item:hover {
        color: #38bdf8;
    }

    @media (max-width: 860px) {
        .nav-menu {
            display: none;
        }

        .nav-inner {
            padding: 0.75rem 1.25rem;
        }
    }
</style>


