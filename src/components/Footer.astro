---
const today = new Date();
---

<footer class="poster-footer">
    <div class="footer-container">
        <div class="footer-inner">
            <div class="footer-left">
                <span class="status-indicator-dot"></span>
                <span class="footer-text font-mono">PROGRAMER MALAS — FULLSTACK SOFTWARE ENGINEER</span>
            </div>

            <div class="footer-links">
                <a href="https://github.com/aliemtakarai" target="_blank" rel="noopener noreferrer" class="footer-nav-link">GITHUB</a>
                <a href="https://www.linkedin.com/in/aliem-arif-perkasa/" target="_blank" rel="noopener noreferrer" class="footer-nav-link">LINKEDIN</a>
                <a href="/works" class="footer-nav-link">WORKS</a>
                <a href="/blog" class="footer-nav-link">BLOG</a>
            </div>
        </div>

        <div class="footer-sub-line">
            <span>&copy; {today.getFullYear()} BUILT WITH ASTRO.</span>
        </div>
    </div>
</footer>

<style>
    .poster-footer {
        background: #090e17;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 2rem 2.5rem;
        width: 100%;
    }

    .footer-container {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .footer-left {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .status-indicator-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #38bdf8;
        box-shadow: 0 0 8px #38bdf8;
    }

    .footer-text {
        font-size: 0.8rem;
        color: #94a3b8;
        letter-spacing: 1px;
    }

    .footer-links {
        display: flex;
        align-items: center;
        gap: 1.75rem;
    }

    .footer-nav-link {
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 600;
        color: #cbd5e1;
        letter-spacing: 1px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .footer-nav-link:hover {
        color: #38bdf8;
        text-shadow: 0 0 8px rgba(56, 189, 248, 0.5);
    }

    .footer-sub-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--font-body);
        font-size: 0.72rem;
        color: #64748b;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 1rem;
    }

    .font-mono {
        font-family: var(--font-mono);
    }

    @media (max-width: 640px) {
        .poster-footer {
            padding: 1.75rem 1.25rem;
        }

        .footer-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .footer-sub-line {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
